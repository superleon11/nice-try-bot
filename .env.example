# Required
DISCORD_TOKEN=your_bot_token_here
DATABASE_URL=postgresql://user:password@localhost:5432/funbot

# The one channel the daily throwback reads history from AND posts in
# (enable Developer Mode, right-click the channel, Copy Channel ID). NSFW channels are fine.
THROWBACK_CHANNEL_ID=

# Optional
# Hour (0-23, UTC) the daily throwback is posted
THROWBACK_HOUR_UTC=12
# Read history from a different channel than the one it posts in (default: same channel)
# THROWBACK_SOURCE_CHANNEL_ID=
# Size in days of the random slice of history searched each day (default 30)
# THROWBACK_WINDOW_DAYS=30

# Soundboard visits (all optional, these are the defaults)
# SOUND_VISITS_ENABLED=true
# Minutes a call must have lasted before the bot is allowed to visit
# SOUND_MIN_CALL_MINUTES=15
# After that, wait a random time between these many minutes before joining
# SOUND_MIN_DELAY_MINUTES=15
# SOUND_MAX_DELAY_MINUTES=45
# Minimum number of people (not bots) that must be in the call
# SOUND_MIN_HUMANS=2

# AI chat and memory (optional: nothing AI runs without a key)
# ANTHROPIC_API_KEY=
# Models: haiku is the cheapest; claude-sonnet-5-5 is about twice the price
# LLM_CHAT_MODEL=claude-haiku-4-5-20251001
# LLM_MEMORY_MODEL=claude-haiku-4-5-20251001
# Spending caps in US dollars (the bot refuses calls that could go over)
# LLM_DAILY_BUDGET_USD=0.50
# LLM_MONTHLY_BUDGET_USD=10
# "addressed" = learn only from messages to the bot, "all" = learn from everything said
# LLM_LEARN_SCOPE=addressed
# Hour (0-23, UTC) the notes are updated each day
# LLM_MEMORY_HOUR_UTC=4
# Seconds after the bot replies to you during which your next messages count as talking to it, no @ needed (0 = off)
# LLM_CONVO_WINDOW_SECONDS=180
# Unprompted replies to messages that don't mention the bot
# Chance per message (0 switches it off), seconds between chime-ins per channel
# LLM_RANDOM_REPLY_CHANCE=0.05
# LLM_RANDOM_COOLDOWN_SECONDS=300
# Only chime in in these channels (comma-separated channel IDs); empty = all channels
# LLM_RANDOM_CHANNEL_IDS=
# Override the bot's personality
# LLM_PERSONA=

# Image generation (optional: needs an OpenAI API key; may require Organization Verification there)
# OPENAI_API_KEY=
# IMAGE_MODEL=gpt-image-2.5-flare
# low, medium, high, xhigh, max or auto: higher = prettier and pricier
# IMAGE_QUALITY=medium
# IMAGE_SIZE=1024x1024
# Assumed worst-case cost of ONE image, reserved before each request (set lower once you've seen real costs)
# IMAGE_MAX_COST_USD=0.25
# Daily spending cap for images only (they also count toward LLM_DAILY_BUDGET_USD / LLM_MONTHLY_BUDGET_USD)
# IMAGE_DAILY_BUDGET_USD=1.00
